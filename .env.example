# Santhe Agriculture Platform - Environment Configuration
# Copy this file to .env and fill in your actual values

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# Option 1: Use Neon Cloud (Production - Recommended)
DATABASE_URL=postgresql://username:password@your-neon-host.neon.tech/santhe?sslmode=require

# Option 2: Use Local PostgreSQL (Development)
# DATABASE_URL=postgresql://postgres:postgres@postgres:5432/santhe

# Local PostgreSQL Settings (only needed if using local database)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=santhe

# ============================================================================
# AUTHENTICATION & SECURITY
# ============================================================================

# JWT Secret (Change this to a random string in production!)
JWT_SECRET=your_super_secret_jwt_key_here_change_this

# Session Secret (Change this to a random string in production!)
SESSION_SECRET=your_super_secret_session_key_here_change_this

# ============================================================================
# CLOUDINARY (IMAGE STORAGE)
# ============================================================================
# Sign up at: https://cloudinary.com

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ============================================================================
# CASHFREE PAYMENT GATEWAY
# ============================================================================
# Sign up at: https://www.cashfree.com

CASHFREE_APP_ID=your_app_id
CASHFREE_SECRET_KEY=your_secret_key
CASHFREE_MODE=sandbox  # Use 'production' for live payments

# ============================================================================
# ZEPTOMAIL (EMAIL SERVICE)
# ============================================================================
# Sign up at: https://www.zeptomail.com

ZEPTO_API_KEY=your_zepto_api_key
ZEPTO_FROM_EMAIL=admin@farmersanthe.com

# ============================================================================
# AI SERVICES (ZBNF RECOMMENDATIONS)
# ============================================================================

# OpenAI API (Required for AI features)
# Sign up at: https://platform.openai.com
OPENAI_API_KEY=sk-your-openai-api-key

# Optional: Anthropic Claude API
ANTHROPIC_API_KEY=your_anthropic_key

# Optional: Google Gemini API
GEMINI_API_KEY=your_gemini_key

# ============================================================================
# APPLICATION URLS
# ============================================================================

# Frontend URL (used for CORS, email links, etc.)
FRONTEND_URL=http://localhost:5000

# Backend URL (used for API calls)
BACKEND_URL=http://localhost:5000

# ============================================================================
# NODE ENVIRONMENT
# ============================================================================

NODE_ENV=production
PORT=5000
