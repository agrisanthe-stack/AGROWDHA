 #============================================
# Authentication (Required)
# ============================================
# A secure 32-character random string for your local sessions
BETTER_AUTH_SECRET=local_testing_secret_key_must_be_32_chars_long

# The URL where you will open the Openinary dashboard in your browser
BETTER_AUTH_URL=http://34.93.61.49:3000
#BETTER_AUTH_URL=http://localhost:3000
# ============================================
# Accessibility (Optional)
# ============================================
# Replace 5173 with the actual port your local app runs on (e.g., 3000, 5173, 8080)
CORS_ORIGIN=http://localhost:3000, *

# ============================================
# API Configuration (Full Stack)
# ============================================
NEXT_PUBLIC_API_BASE_URL=/api
