# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@database:5432/santhe
NEON_DATABASE_URL=postgresql://postgres:postgres@database:5432/santhe

# JWT Configuration
JWT_SECRET=your_jwt_secret_here_change_in_production
SESSION_SECRET=your_session_secret_here_change_in_production

# Cloudinary Configuration (required for image uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email Configuration (Zepto Mail)
ZEPTO_API_KEY=your_zepto_api_key
ZEPTO_FROM_EMAIL=noreply@farmersanthe.com

# Payment Gateway (Cashfree)
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key

# AI Configuration (optional - for ZBNF recommendations)
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
GEMINI_API_KEY=your_gemini_api_key

# Application Configuration
NODE_ENV=production
PORT=5000