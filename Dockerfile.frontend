# Multi-stage build for React frontend
FROM node:20-alpine AS build

# Set working directory
WORKDIR /app

# Copy package files
COPY package*.json ./

# Install all dependencies (including dev dependencies for build)
#RUN npm ci
RUN npm ci --include=dev

# Copy all source code needed for build
COPY client ./client
COPY shared ./shared
COPY public ./public

# Copy configuration files
COPY vite.config.ts ./
COPY tsconfig.json ./
COPY tailwind.config.ts ./
COPY postcss.config.js ./
COPY components.json ./
COPY types.d.ts ./

# Create the dist directory
RUN mkdir -p dist/public
RUN npm install -g vite
# Build the frontend - output goes to dist/public per vite.config.ts
RUN npx vite build

# Debug: List the build output
RUN echo "=== Build output ===" && ls -la dist/ && ls -la dist/public/

# Production stage
FROM nginx:alpine

# Copy built files to nginx (from dist/public as per vite.config.ts)
COPY --from=build /app/dist/public /usr/share/nginx/html
COPY public/logo-santhe.png /usr/share/nginx/html/logo-santhe.png
RUN chmod 644 /usr/share/nginx/html/logo-santhe.png
# Copy nginx configuration
#COPY docker/nginx/nginx.conf etc/nginx/nginx.conf
#COPY docker/nginx.conf /etc/nginx/conf.d/nginx.conf
#COPY docker/nginx.conf /etc/nginx/nginx.conf

# Expose port
EXPOSE 80

# Start nginx
CMD ["nginx", "-g", "daemon off;"]


