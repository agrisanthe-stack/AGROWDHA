FROM node:20-alpine
WORKDIR /app

# ── System deps ──────────────────────────────────────────────────────────────
# ffmpeg         : assembles slides + audio into MP4
# ca-certificates: needed for HTTPS calls to Cloudinary / Neon / Ollama etc.
# (edge-tts / Python removed — replaced by Piper TTS self-hosted service)
RUN apk add --no-cache \
    ffmpeg \
    python3 \
    py3-pip \
    ca-certificates
RUN pip3 install --break-system-packages edge-tts

#COPY package.json ./
COPY . ./
RUN npm install
#RUN npm install -g drizzle-kit drizzle-orm tsx
#RUN npm install -g vite esbuild
#RUN npm install 
#COPY server ./server
#COPY client ./client
#COPY vite.config.ts ./
#COPY shared ./shared
#COPY db ./db
#COPY drizzle.config.ts ./
#COPY tsconfig.json ./
#COPY types.d.ts ./
#COPY . ./
RUN mkdir -p public/uploads
RUN npm run build



# Debug: Show build output
RUN echo "=== Backend build output ===" && ls -la dist/
ENV NODE_ENV=production
#RUN npm run build
EXPOSE 5000
COPY entrypoint.sh ./
RUN chmod +x entrypoint.sh
# Replace CMD with:
CMD ["./entrypoint.sh"]

#CMD ["node", "dist/index.js"]
